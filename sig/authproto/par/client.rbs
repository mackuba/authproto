module AuthProto
  module PAR
    class Client
      attr_reader authorization_server: Metadata::AuthorizationServer
      attr_reader par_endpoint: String
      attr_reader dpop_client: DPoP::Client

      def initialize: (authorization_server: Metadata::AuthorizationServer, dpop_client: DPoP::Client) -> void
      def submit: (Request request) -> Response
      def extract_nonce: (http_response response) -> String
      def build_authorization_url: (request_uri: String, client_id: String) -> String

      private
      def make_request: (Request request) -> http_response
      def build_headers: (Request request, String dpop_proof) -> Hash[String, String]
      def requires_nonce?: (http_response response) -> bool
      def store_nonce: (String nonce) -> void
      def server_origin: () -> String
      def handle_error_response: (http_response response) -> bot
      def process_response: (http_response response) -> Response
    end
  end
end
