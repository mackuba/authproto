module AuthProto
  module PAR
    class Request
      @client_id: String
      @redirect_uri: String
      @code_challenge: String
      @state: String
      @scope: String
      @login_hint: String?
      @prompt: String?
      @nonce: String?
      @client_assertion: ClientAssertion?

      class Configuration
        attr_accessor client_id: String?
        attr_accessor redirect_uri: String?
        attr_accessor code_challenge: String?
        attr_accessor state: String?
        attr_accessor scope: String?
        attr_accessor login_hint: String?
        attr_accessor prompt: String?
        attr_accessor nonce: String?
        attr_accessor client_assertion: ClientAssertion?
      end

      attr_reader client_id: String
      attr_reader code_challenge: String
      attr_reader state: String
      attr_reader redirect_uri: String
      attr_reader scope: String
      attr_reader login_hint: String?
      attr_reader prompt: String?
      attr_reader nonce: String?
      attr_reader client_assertion: ClientAssertion?

      def self.build: () { (Configuration) -> untyped } -> Request

      def initialize: (Configuration config) -> void

      def to_form: (?audience: String?) -> String

      private

      def build_params: (audience: String?) -> Hash[String, String]

      def validate_request: () -> void

      def validate_required_params: () -> void

      def validate_client_auth: () -> void
    end
  end
end
