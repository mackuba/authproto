module AuthProto
  module DPoP
    class KeySet
      class KeyError < AuthProto::Error
      end

      CURVE: String
      attr_reader key: JOSE::JWK

      def initialize: (?JOSE::JWK? key) -> void
      def public_jwk: () -> json_object
      def sign_segments: (Hash[String | Symbol, untyped] header, Hash[String | Symbol, untyped] payload) -> JOSE::SignedBinary
      def private_jwk: () -> json_object
      def self.from_jwk: (json_object | JOSE::Map jwk) -> KeySet

      private
      def generate_keypair: () -> JOSE::JWK
      def sign: (String data) -> JOSE::SignedBinary
      def deep_stringify_keys: (untyped obj) -> untyped
      def verify: (String signed_jws) -> bool
      def validate_keypair: () -> void
    end
  end
end
