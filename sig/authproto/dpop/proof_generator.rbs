module AuthProto
  module DPoP
    class ProofGenerator
      class ProofError < AuthProto::Error
      end

      def initialize: () -> void

      def generate: (
          key_set: KeySet,
          method: String,
          uri: (String | URI::HTTPS),
          ?nonce: String?,
          ?access_token: String?
        ) -> JOSE::SignedBinary

      private

      def validate_inputs: (String method, (String | URI::HTTPS) uri) -> void

      def build_header: (KeySet key_set) -> { typ: "dpop+jwt", alg: "ES256", jwk: Hash[String, untyped] }

      def build_payload: (
          method: String,
          uri: (String | URI::HTTPS),
          ?nonce: String?,
          ?access_token: String?
        ) -> Hash[String, untyped]

      def normalize_uri: ((String | URI::HTTPS) uri) -> String

      def generate_access_token_hash: (String access_token) -> String
    end
  end
end
