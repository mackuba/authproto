module AuthProto
  module DPoP
    class ProofGenerator
      class ProofError < AuthProto::Error
      end

      def initialize: () -> void

      def generate: (
          key_manager: KeyManager,
          method: String,
          uri: String,
          ?nonce: String?,
          ?access_token: String?,
          ?ath: bool?
        ) -> JOSE::SignedBinary

      private

      def validate_inputs: (String method, String uri) -> void

      def build_header: (KeyManager key_manager) -> { typ: "dpop+jwt", alg: "ES256", jwk: Hash[String, untyped] }

      def build_payload: (
          method: String,
          uri: String,
          ?nonce: String?,
          ?access_token: String?,
          ?include_ath: bool?
        ) -> Hash[String, untyped]

      def normalize_uri: (String uri) -> String

      def generate_access_token_hash: (String access_token) -> String
    end
  end
end
