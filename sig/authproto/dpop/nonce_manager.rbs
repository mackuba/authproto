module AuthProto
  module DPoP
    class NonceManager
      @ttl: Integer
      @serializer: Serialization::StoredNonce

      class NonceError < AuthProto::Error
      end

      def initialize: (?ttl: Integer?) -> void
      def update: (nonce: String, url: (String | URI::HTTPS), session_id: String) -> void
      def get: (url: (String | URI::HTTPS), session_id: String) -> String?
      def clear: (url: (String | URI::HTTPS), session_id: String) -> bool

      private
      def validate_session_id: (String session_id) -> void
      def normalize_url: ((String | URI::HTTPS) url) -> String
      def validate_inputs: (String nonce, (String | URI::HTTPS) url) -> void
      def validate_url: ((String | URI::HTTPS) url) -> void
    end
  end
end
