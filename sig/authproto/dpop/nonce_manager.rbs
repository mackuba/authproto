module AuthProto
  module DPoP
    class NonceManager
      @ttl: Integer
      @serializer: Serialization::StoredNonce

      class NonceError < AuthProto::Error
      end

      DEFAULT_TTL: Integer
      def initialize: (?ttl: Integer?) -> void
      def update: (nonce: String, server_url: String) -> void
      def get: (String server_url) -> String?
      def clear: (String server_url) -> bool
      def valid_nonce?: (String server_url) -> bool

      private
      def normalize_server_url: (String url) -> String
      def validate_inputs: (String nonce, String server_url) -> void
      def validate_server_url: (String server_url) -> void
    end
  end
end
