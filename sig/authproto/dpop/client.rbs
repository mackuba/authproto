module AuthProto
  module DPoP
    class Client
      include HTTPHelpers
      class Error < AuthProto::Error
      end

      attr_reader proof_generator: ProofGenerator
      attr_reader nonce_manager: NonceManager

      def initialize: (?nonce_ttl: Integer?) -> void
      def generate_proof: (session: State::Session, method: String, uri: String, ?access_token: String?) -> JOSE::SignedBinary
      def has_nonce_error?: (http_response response) -> bool
      def process_response: (http_response response, server_url: String, session_id: String) -> void

      def with_nonce_handling: (State::Session session, String url) { () -> http_response } -> http_response

      private

      def validate_response_fields: (http_response response) -> void
      def nonce_challenge?: (String? challenge) -> bool
    end
  end
end
