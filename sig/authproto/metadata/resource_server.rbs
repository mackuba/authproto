module AuthProto
  module Metadata
    class ResourceServer
      @authorization_server: String

      attr_reader authorization_server: String

      def initialize: (Hash[String, untyped] metadata) -> void

      def self.from_url: (String url) -> ResourceServer

      private

      def validate_authorization_servers: (untyped servers) -> String

      private def self.fetch_metadata: (String url) -> http_response

      private def self.validate_source_url: (String url) -> void

      private def self.parse_metadata: (String? body) -> Hash[String, untyped]

      private def self.validate_response: (http_response response) -> void

      private def self.validate_resource: (untyped resource, String url) -> void
    end
  end
end
