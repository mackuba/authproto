module AuthProto
  class Client
    include HTTPHelpers
    class CallbackError < AuthProto::Error
    end
    class TokenError < AuthProto::Error
    end
    class SessionError < AuthProto::Error
      attr_reader session_id: String?
      def initialize: (String message, ?session_id: String?) -> void
    end

    attr_reader client_id: String
    attr_reader redirect_uri: String
    attr_reader client_metadata: Metadata::ClientMetadata
    attr_reader session_manager: State::SessionManager
    attr_reader dpop_client: DPoP::Client

    def self.for_localhost: (redirect_uri: (String | URI::Generic), ?scope: String) -> instance

    def initialize: (
        client_id: String,
        redirect_uri: (String | URI::Generic),
        ?metadata: json_object?,
        ?signing_key: (json_object | JOSE::JWK)?
      ) -> void
    def http: () -> _HTTPClient?
    def authorize: (?handle: String?, ?pds: (String | URI::HTTPS)?, ?scope: String) -> authorization_result
    def handle_callback: (code: String, state: String, iss: String, expected_session_id: String) -> callback_result
    def get_tokens: (String session_id) -> token_info?
    def refresh_token: (String session_id) -> refreshed_tokens
    def authorized?: (String session_id) -> bool
    def auth_headers: (session_id: String, method: String, url: (String | URI::HTTPS)) -> Hash[String, String]
    def process_dpop: (http_response response, url: (String | URI::HTTPS), session_id: String) -> void
    def has_nonce_error?: (http_response response) -> bool
    def with_nonce_handling: (String session_id, (String | URI::HTTPS) url) { () -> http_response } -> http_response
    def delete_session: (String session_id, ?revoke: bool) -> void
    def cleanup_expired_sessions: () -> void

    private
    def load_client_metadata: (json_object? metadata) -> Metadata::ClientMetadata
    def validate_redirect_uri: () -> void
    def loopback_redirect_components: (String url) -> Array[String?]?
    def initialize_client_assertion: ((json_object | JOSE::JWK)? key) -> String?
    def metadata_key_matches_public_key?: (json_object candidate, json_object public_key) -> bool
    def validate_auth_params: (String? handle, (String | URI::HTTPS)? pds, String scope) -> void
    def resolve_auth_server_info: (String pds) -> Metadata::AuthorizationServer
    def submit_authorization_par: (
        Metadata::AuthorizationServer authorization_server,
        State::Session session,
        ?login_hint: String?
      ) -> String
    def exchange_code: (code: String, session: State::Session) -> State::TokenSet
    def make_token_request: (String code, State::Session session) -> http_response
    def validate_token_identity: (State::TokenSet tokens, State::Session session) -> void
    def revoke_rejected_refresh_token: (String token, State::Session session) -> void
  end
end
