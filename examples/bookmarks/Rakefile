# frozen_string_literal: true

require 'sinatra/activerecord/rake'

require_relative 'app/init'
require_relative 'app/account'
require_relative 'app/bookmark_sync'

namespace :bookmarks do
  desc "Sync new bookmarks and clean up signed-out sessions: bookmarks:fetch[did]"
  task :fetch, [:did] => 'db:load_config' do |task, args|
    did = args[:did] || ENV['DID']
    abort "Pass the owner's DID: bundle exec rake 'bookmarks:fetch[did:plc:...]'" if did.to_s.empty?

    account = Account.find_by(did: did)
    abort "No bookmark account for #{did}. Sign in through the web app first." unless account

    count = BookmarkSync.new(account).run

    if count
      puts "Fetched #{count} new bookmarks for #{did}."
    else
      puts "Background sync is off for #{did}. Cleaned up signed-out sessions."
    end
  rescue Minisky::AuthError => e
    abort e.message
  end
end
