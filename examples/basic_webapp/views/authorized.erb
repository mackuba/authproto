<div class="page">
  <div class="page-header">
    <h1 class="page-title">Successfully Authenticated!</h1>
  </div>

  <div class="page-content">
    <div class="authorized-content">
      <% if session[:error] %>
        <div class="message message-error">
          <%= session[:error] %>
          <% session[:error] = nil %>
        </div>
      <% end %>

      <% if session[:notice] %>
        <div class="message message-success">
          <%= session[:notice] %>
          <% session[:notice] = nil %>
        </div>
      <% end %>

      <form method="post" action="/posts" class="form">
        <fieldset>
          <label for="post-text" class="field-label">New Bluesky post</label>
          <textarea id="post-text" name="text" rows="4" maxlength="300" required
              placeholder="What's up?" class="post-input">
          </textarea>
        </fieldset>
        <div>
          <button type="submit" class="button">Post to Bluesky</button>
        </div>
      </form>

      <div class="token-info">
        <p class="field-label">Token Information</p>
        <pre class="data-output"><code><%= JSON.pretty_generate(@session) %></code></pre>
      </div>

      <div class="api-test">
        <p class="field-label">Test API Call Result</p>
        <pre class="data-output"><code><%= JSON.pretty_generate(@api_result) %></code></pre>
      </div>

      <div class="signout-actions">
        <a href="/signout" aria-label="Signout" class="button button-truncate">Sign out</a>
      </div>
    </div>
  </div>
</div>
